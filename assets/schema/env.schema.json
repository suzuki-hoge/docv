{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "環境変数（guide/env.yaml）",
  "description": "システムを動かすのに要る環境変数と、それぞれを設定している場所",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "envs": {
      "description": "環境変数の配列",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "desc"
        ],
        "properties": {
          "key": {
            "description": "環境変数の名前",
            "type": "string"
          },
          "desc": {
            "description": "何に使うか",
            "type": "string"
          },
          "secret": {
            "description": "秘密の値か",
            "type": "boolean",
            "default": false
          },
          "local_from": {
            "description": "ローカル環境で、どこで設定しているか（Docker Compose、`.env` など）",
            "type": "string"
          },
          "release_from": {
            "description": "ステージングや本番で、どこで設定しているか（ECS のタスク定義、SSM など）",
            "type": "string"
          }
        }
      }
    }
  }
}
